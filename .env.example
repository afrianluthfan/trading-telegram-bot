# Testnet configuration — copy to .env and fill in your keys
BINANCE_API_KEY=xxxxxxx
BINANCE_API_SECRET=xxxxxx
BINANCE_API_BASE=https://testnet.binancefuture.com
BINANCE_WS_BASE=wss://stream.binancefuture.com

TELEGRAM_BOT_TOKEN=0000000000:xxxxx-xxxxxx
TELEGRAM_CHAT_ID=-000000000

# Comma-separated list of symbols to monitor
SYMBOLS=BTCUSDT

# Risk parameters
MARGIN_CAP=1000
LEVERAGE=100
SL_DELTA=0.0015

# Institutional filter thresholds
LONG_RETAIL_LS_MAX=1.0
LONG_TOP_LS_MIN=1.5
SHORT_RETAIL_LS_MIN=1.5
SHORT_TOP_LS_MAX=0.8

# Cooldown: number of 5m candles to skip after a trade
POST_TRADE_COOLDOWN=3

# API weight safety threshold (max 2400)
API_WEIGHT_PAUSE_THRESHOLD=1800
